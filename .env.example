# iCore connection
ICORE_BASE_URL=https://icore.example.com
ICORE_API_PATH=/api/v2/icore
ICORE_LOGIN_ORIGIN=https://portal.example.com/
# Depending on the deployed iCore version use /loggedUser or /auth/userinfo
ICORE_USERINFO_PATH=/loggedUser
ICORE_TIMEOUT_SECONDS=30
ICORE_VERIFY_SSL=true

# Authentication
REQUIRE_AUTHENTICATION=true
TOKEN_CACHE_SECONDS=300
AUTH_COOKIE_NAME=service_portal_icore
# false for plain HTTP localhost development; true in production
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_MAX_AGE=3600

# Semantic mapping
SEMANTICS_CONFIG_PATH=config/semantics.json

# Frontend origins
CORS_ORIGINS=http://localhost:5173
