# Mandatory iCore connection configuration.
# Both values below are required for the current development environment.
ICORE_BASE_URL=https://c03-insinno-internal-dev.insinno.de/
ICORE_API_PATH=/api/v2/icore
ICORE_LOGIN_ORIGIN=https://c03-insinno-internal-dev.insinno.de/

ICORE_TIMEOUT_SECONDS=10.0
# AUTHENTICATION.md specifies false for the development environment.
ICORE_VERIFY_SSL=false

# Authentication
REQUIRE_AUTHENTICATION=true
# Validated live iCore tokens are cached for five minutes.
TOKEN_CACHE_SECONDS=300

# Semantic mapping
SEMANTICS_CONFIG_PATH=config/semantics.json

# Mock mode for frontend/test development.
# In mock mode /auth/login returns a token immediately without validating credentials.
USE_MOCK_DATA=false
MOCK_DATA_PATH=config/mock/icore-api.json
MOCK_ACCESS_TOKEN=mock-service-portal-token
MOCK_TOKEN_EXPIRES_IN=86400

# Frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
