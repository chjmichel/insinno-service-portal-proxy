{
  "version": 1,
  "resources": {
    "useCases": {
      "source": {
        "method": "GET",
        "path": "/service-portal/use-cases",
        "collectionPath": "items"
      },
      "map": {
        "id": "id",
        "customerId": "customerId",
        "name": "name",
        "type": "type",
        "category": "category",
        "description": "description",
        "status": "status",
        "currentProject": "currentProject",
        "customerAction": "customerAction",
        "dashboardConfigId": "dashboardConfigId",
        "enabledCapabilities": "enabledCapabilities",
        "primaryKpi": "primaryKpi",
        "secondaryKpi": "secondaryKpi"
      }
    },
    "projects": {
      "source": {
        "method": "GET",
        "path": "/service-portal/projects",
        "collectionPath": "items"
      },
      "map": {
        "id": "id",
        "useCaseId": "useCaseId",
        "name": "name",
        "status": "status",
        "progress": "progress",
        "startDate": "startDate",
        "targetDate": "targetDate",
        "responsible": "responsible",
        "projectManager": "projectManager",
        "developmentTeam": "developmentTeam"
      }
    },
    "epics": {
      "source": {
        "method": "GET",
        "path": "/service-portal/epics",
        "collectionPath": "items"
      },
      "map": {
        "id": "id",
        "projectId": "projectId",
        "name": "name",
        "status": "status",
        "progress": "progress",
        "targetDate": "targetDate"
      }
    },
    "kpis": {
      "source": {
        "method": "GET",
        "path": "/service-portal/kpis",
        "collectionPath": "items"
      },
      "map": {
        "id": "id",
        "useCaseId": "useCaseId",
        "name": "name",
        "value": "value",
        "target": "target",
        "delta": "delta",
        "health": "health"
      }
    }
  },
  "schemas": [
    {
      "objectType": "USE_CASE",
      "label": "Use Case",
      "attributes": [
        {"key": "name", "label": "Name", "type": "string", "required": true},
        {"key": "category", "label": "Category", "type": "string"},
        {"key": "description", "label": "Description", "type": "text"},
        {"key": "status", "label": "Service Status", "type": "status"},
        {"key": "customerAction", "label": "Customer Action", "type": "text"}
      ]
    },
    {
      "objectType": "PROJECT",
      "label": "Project",
      "attributes": [
        {"key": "name", "label": "Project", "type": "string", "required": true},
        {"key": "status", "label": "Status", "type": "status"},
        {"key": "progress", "label": "Progress", "type": "percentage"},
        {"key": "startDate", "label": "Start", "type": "date"},
        {"key": "targetDate", "label": "Target", "type": "date"},
        {"key": "responsible", "label": "Responsible", "type": "person"},
        {"key": "projectManager", "label": "Project Manager", "type": "person"},
        {"key": "developmentTeam", "label": "Development Team", "type": "string"}
      ]
    },
    {
      "objectType": "EPIC",
      "label": "Epic",
      "attributes": [
        {"key": "name", "label": "Epic", "type": "string"},
        {"key": "status", "label": "Status", "type": "status"},
        {"key": "progress", "label": "Progress", "type": "percentage"},
        {"key": "targetDate", "label": "Target", "type": "date"}
      ]
    },
    {
      "objectType": "KPI",
      "label": "KPI",
      "attributes": [
        {"key": "name", "label": "KPI", "type": "string"},
        {"key": "value", "label": "Value", "type": "string"},
        {"key": "target", "label": "Target", "type": "string"},
        {"key": "delta", "label": "Trend", "type": "number"}
      ]
    }
  ]
}
