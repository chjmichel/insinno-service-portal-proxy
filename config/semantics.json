          "es": "Diseño de solución"
        }
      }
    },
    "serviceObjectTypes": {
      "EPIC": {
        "labels": {
          "en": "Epic",
          "de": "Epic",
          "fr": "Epic",
          "es": "Epic"
        }
      },
      "TASK": {
        "labels": {
          "en": "Task",
          "de": "Aufgabe",
          "fr": "Tâche",
          "es": "Tarea"
        }
      },
      "MILESTONE": {
        "labels": {
          "en": "Milestone",
          "de": "Meilenstein",
