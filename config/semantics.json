{
  "version": "1.2.0",
  "description": "Semantic mapping for the insinno Service Portal. Stable portal concepts are derived from generic iCore entities by semantic type discriminators.",
  "discriminators": {
    "productType": "product.producttype.name",
    "serviceObjectType": "objectitem.objectType"
  },
  "resources": {
    "useCases": {
      "source": {
        "entity": "ContractDTO",
        "endpoint": "/contracts",
        "method": "GET",
        "mockKey": "contracts"
      },
      "filters": {
        "product.producttype.name": "USE_CASE"
      },
      "semanticType": "USE_CASE"
    },
    "apps": {
      "source": {
        "entity": "AppDTO",
        "endpoint": "/apps",
        "method": "GET",
        "mockKey": "apps"
      },
      "filters": {},
      "semanticType": "APP"
    },
    "projects": {
      "source": {
        "entity": "ContractDTO",
        "endpoint": "/contracts",
        "method": "GET",
        "mockKey": "contracts"
      },
      "filters": {
        "product.producttype.name": "PROJECT"
      },
      "semanticType": "PROJECT"
    },
    "epics": {
      "source": {
        "entity": "ServiceContractDTO",
        "endpoint": "/servicecontracts",
        "method": "GET",
        "mockKey": "servicecontracts"
      },
      "filters": {
        "objectitem.objectType": "EPIC"
      },
      "semanticType": "EPIC"
    },
    "milestones": {
      "source": {
        "entity": "ServiceContractDTO",
        "endpoint": "/servicecontracts",
        "method": "GET",
        "mockKey": "servicecontracts"
      },
      "filters": {
        "objectitem.objectType": "MILESTONE"
      },
      "semanticType": "MILESTONE"
    },
    "tasks": {
      "source": {
        "entity": "ServiceContractDTO",
        "endpoint": "/servicecontracts",
        "method": "GET",
        "mockKey": "servicecontracts"
      },
      "filters": {
        "objectitem.objectType": "TASK"
      },
      "semanticType": "TASK"
    },
    "kpis": {
      "source": {
        "entity": "ServiceContractDTO",
        "endpoint": "/servicecontracts",
        "method": "GET",
        "mockKey": "servicecontracts"
      },
      "filters": {
        "objectitem.objectType": "KPI_DEFINITION"
      },
      "semanticType": "KPI_DEFINITION"
    },
    "serviceProducts": {
      "source": {
        "entity": "ProductDTO",
        "endpoint": "/products",
        "method": "GET",
        "mockKey": "products"
      },
      "filters": {
        "producttype.name": "SERVICE"
      },
      "semanticType": "SERVICE"
    },
    "services": {
      "source": {
        "entity": "ServiceContractDTO",
        "endpoint": "/servicecontracts",
        "method": "GET",
        "mockKey": "servicecontracts"
      },
      "filters": {},
      "semanticType": "SERVICE",
      "resolution": {
        "productReference": "serviceDetails[sourceProductId].value, or unique SERVICE Product.objectitems membership for native generation",
        "productType": "SERVICE",
        "objectItem": "objectitem.id must belong to source Product.objectitems",
        "parent": "ServiceContract.contract -> SERVICE Contract.parentcontract -> USE_CASE"
      }
    }
  },
  "types": {
    "productTypes": {
      "USE_CASE": {
        "labels": {
          "en": "Use case",
          "de": "Use Case",
          "fr": "Cas d’usage",
          "es": "Caso de uso"
        }
      },
      "PROJECT": {
        "labels": {
          "en": "Project",
          "de": "Projekt",
          "fr": "Projet",
          "es": "Proyecto"
        }
      },
      "CHANGE": {
        "labels": {
          "en": "Change",
          "de": "Änderung",
          "fr": "Changement",
          "es": "Cambio"
        }
      },
      "SERVICE_PACKAGE": {
        "labels": {
          "en": "Service package",
          "de": "Servicepaket",
          "fr": "Pack de services",
          "es": "Paquete de servicios"
        }
      },
      "SERVICE": {
        "labels": {
          "en": "Service",
          "de": "Service",
          "fr": "Service",
          "es": "Servicio"
        }
      }
    },
    "projectTypes": {
      "REENGINEERING": {
        "labels": {
          "en": "Reengineering",
          "de": "Reengineering",
